rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function active() {
      return signedIn() && profile().data.active == true &&
        profile().data.suspended != true;
    }
    function owner() { return active() && profile().data.role == 'owner'; }
    function agent() { return active() && profile().data.role == 'agent'; }
    function leader() { return active() && profile().data.role == 'leader'; }
    function clientAccess() {
      return owner() || (active() && resource.data.assignedTo == request.auth.uid) ||
        (leader() && resource.data.teamId is string &&
          resource.data.teamId in profile().data.get('authorizedTeamIds', []));
    }
    function canReadClient(clientId) {
      return active() && (owner() ||
        get(/databases/$(database)/documents/clients/$(clientId)).data.assignedTo == request.auth.uid ||
        (leader() &&
          get(/databases/$(database)/documents/clients/$(clientId)).data.teamId is string &&
          get(/databases/$(database)/documents/clients/$(clientId)).data.teamId in
            profile().data.get('authorizedTeamIds', [])));
    }

    // The first owner record is provisioned through the Firebase console or a
    // trusted admin process after verifying Juan's Auth UID. Clients cannot
    // create or change users, roles, suspension or team grants.
    match /users/{uid} {
      allow get: if active() && (owner() || request.auth.uid == uid);
      allow list: if owner();
      allow create, update, delete: if false;
      match /preferences/{prefId} {
        allow read: if active() && (owner() || request.auth.uid == uid);
        allow create, update: if active() && request.auth.uid == uid &&
          prefId == 'operational' && request.resource.data.keys().hasOnly([
            'autoRefresh', 'notifications', 'updatedAt'
          ]) && request.resource.data.autoRefresh is bool &&
          request.resource.data.notifications is bool &&
          request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }
      match /devices/{deviceId} {
        allow read: if active() && (owner() || request.auth.uid == uid);
        // FCM tokens and device authorization are managed by a trusted server.
        allow write: if false;
      }
      // A client may submit its current FCM token for later administrative
      // approval. This request is never an authorized device or a send target.
      match /deviceRequests/{deviceId} {
        allow read: if active() && (owner() || request.auth.uid == uid);
        allow create, update: if active() && request.auth.uid == uid &&
          deviceId.size() >= 16 && deviceId.size() <= 80 &&
          request.resource.data.keys().hasAll(['fcmToken', 'platform', 'appVersion', 'updatedAt']) &&
          request.resource.data.keys().hasOnly(['fcmToken', 'platform', 'appVersion', 'updatedAt']) &&
          request.resource.data.fcmToken is string &&
          request.resource.data.fcmToken.size() >= 20 &&
          request.resource.data.fcmToken.size() <= 4096 &&
          request.resource.data.platform == 'android' &&
          request.resource.data.appVersion is string &&
          request.resource.data.appVersion.size() <= 40 &&
          request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }
    }

    // Recruitment stays owner-only. Sheets/Apps Script remains the source.
    // A trusted server may mirror identifiers after deduplication; the app
    // cannot import recruitment PII into this collection directly.
    match /recruitment/{leadId} {
      allow read: if owner();
      allow write: if false;
      match /activity/{eventId} {
        allow read: if owner();
        allow write: if false;
      }
    }

    // Source registration is administrative and contains no prospect contact data.
    match /recruitmentSources/{leadId} {
      allow read: if owner();
      allow write: if false;
    }
    function registeredRecruitment(id) {
      return id.matches('r_[a-f0-9-]{36}') &&
        get(/databases/$(database)/documents/recruitmentSources/$(id)).data.enabled == true;
    }
    function validRecruitmentValues(d) {
      return d.status in ['Nuevo', 'Contactado', 'Cita', 'Seguimiento', 'Completado'] &&
        d.note is string && d.note.size() <= 4000;
    }
    function statePath(id) { return /databases/$(database)/documents/recruitmentState/$(id); }
    function beforeRevision(id) { return exists(statePath(id)) ? get(statePath(id)).data.revision : 0; }
    function beforeStatus(id) { return exists(statePath(id)) ? get(statePath(id)).data.status : 'Nuevo'; }
    function beforeNote(id) { return exists(statePath(id)) ? get(statePath(id)).data.note : ''; }
    function stateHasEvent(id) {
      let d = request.resource.data;
      let path = /databases/$(database)/documents/recruitmentState/$(id)/activity/$(d.lastEventId);
      let event = getAfter(path).data;
      return !exists(path) && event.kind in ['edit', 'import'] &&
        event.status == d.status && event.note == d.note && event.revision == d.revision &&
        event.actorUid == request.auth.uid && event.createdAt == request.time;
    }
    match /recruitmentState/{leadId} {
      allow read: if owner();
      allow create, update: if owner() && registeredRecruitment(leadId) &&
        request.resource.data.keys().hasOnly(['status', 'note', 'revision', 'lastEventId', 'updatedBy', 'updatedAt']) &&
        validRecruitmentValues(request.resource.data) &&
        request.resource.data.revision is int && request.resource.data.revision == beforeRevision(leadId) + 1 &&
        request.resource.data.lastEventId is string && request.resource.data.lastEventId.matches('[a-zA-Z0-9_-]{16,80}') &&
        request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time &&
        stateHasEvent(leadId);
      allow delete: if false;
      match /activity/{eventId} {
        allow read: if owner();
        allow create: if owner() && registeredRecruitment(leadId) &&
          eventId.matches('[a-zA-Z0-9_-]{16,80}') &&
          request.resource.data.keys().hasOnly(['actorUid', 'deviceId', 'kind', 'status', 'note',
            'previousStatus', 'previousNote', 'baseRevision', 'revision', 'createdAt', 'originalUpdatedAt']) &&
          validRecruitmentValues(request.resource.data) &&
          request.resource.data.actorUid == request.auth.uid &&
          request.resource.data.deviceId is string && request.resource.data.deviceId.size() >= 16 && request.resource.data.deviceId.size() <= 80 &&
          request.resource.data.createdAt == request.time &&
          request.resource.data.originalUpdatedAt is string && request.resource.data.originalUpdatedAt.size() <= 80 &&
          request.resource.data.baseRevision is int && request.resource.data.revision is int &&
          request.resource.data.baseRevision == beforeRevision(leadId) &&
          request.resource.data.previousStatus == beforeStatus(leadId) && request.resource.data.previousNote == beforeNote(leadId) &&
          ((request.resource.data.kind in ['edit', 'import'] &&
            request.resource.data.revision == beforeRevision(leadId) + 1 &&
            getAfter(statePath(leadId)).data.lastEventId == eventId &&
            getAfter(statePath(leadId)).data.revision == request.resource.data.revision &&
            getAfter(statePath(leadId)).data.status == request.resource.data.status &&
            getAfter(statePath(leadId)).data.note == request.resource.data.note &&
            getAfter(statePath(leadId)).data.updatedAt == request.time) ||
           (request.resource.data.kind == 'backup' && exists(statePath(leadId)) &&
            request.resource.data.revision == beforeRevision(leadId) &&
            getAfter(statePath(leadId)).data == get(statePath(leadId)).data));
        allow update, delete: if false;
      }
    }

    // Clients FE are empty for now. A trusted admin process owns canonical
    // classification, assignment and reassignment. LEAD -> B_LEAD edits the
    // same document; assignment history is append-only, server-written.
    match /clients/{clientId} {
      allow get, list: if clientAccess();
      allow create, update, delete: if false;
      match /assignments/{assignmentId} {
        allow read: if canReadClient(clientId);
        allow write: if false;
      }
      match /activity/{eventId} {
        allow read: if canReadClient(clientId);
        allow create: if active() &&
          (owner() || ((agent() || leader()) &&
            get(/databases/$(database)/documents/clients/$(clientId)).data.assignedTo == request.auth.uid)) &&
          request.resource.data.keys().hasOnly(['actorUid', 'kind', 'status', 'note', 'createdAt']) &&
          request.resource.data.actorUid == request.auth.uid &&
          request.resource.data.kind in ['status', 'note', 'result'] &&
          request.resource.data.status is string && request.resource.data.status.size() <= 80 &&
          request.resource.data.note is string && request.resource.data.note.size() <= 4000 &&
          request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    match /{path=**} { allow read, write: if false; }
  }
}
