rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function approvedFixture() {
      return request.auth != null && request.auth.token.email_verified == true &&
        get(/databases/$(database)/documents/stagingTestUsers/$(request.auth.uid)).data.enabled == true &&
        get(/databases/$(database)/documents/stagingTestUsers/$(request.auth.uid)).data.environment == 'pag-leads-staging';
    }
    // Administrative fixture documents only. Client cannot enroll or modify roles.
    match /users/{uid} {
      allow get: if approvedFixture() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
